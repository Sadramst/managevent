# Keep the Docker build context small and free of host artefacts.
# A Windows host node_modules copied into a Linux image breaks native modules
# (esbuild, Prisma engines), so it must never enter the context.
**/node_modules
**/dist
**/.next
**/coverage
**/.turbo
**/.git
**/.env
**/.env.*
!.env.example
**/*.log
**/.DS_Store
**/Thumbs.db

# Apps this deployment does not build or need.
apps/mobile
apps/desktop-win
apps/admin
apps/portal
apps/vendors
apps/invitation
apps/marketing
