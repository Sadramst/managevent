# ───────────────────────────────────────────────────────────────
# Managevent: environment variables (copy to .env, never commit .env)
# Each app documents which subset it needs in its own README.
# APP_ENV: local | preview | staging | production
# ───────────────────────────────────────────────────────────────
APP_ENV=local
NODE_ENV=development

# ── Domains ─────────────────────────────────────────────────────
# Public URLs of the web apps. The API also derives its trusted browser origins from these
# (CORS, CSRF origin checks) and uses them to build links in emails and Stripe return URLs.
# Marketing runs on 3100 locally (see apps/marketing dev script).
NEXT_PUBLIC_MARKETING_URL=http://localhost:3100
NEXT_PUBLIC_INVITATION_URL=http://localhost:3001
NEXT_PUBLIC_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_VENDORS_URL=http://localhost:3003
NEXT_PUBLIC_ADMIN_URL=http://localhost:3004
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side URL the Next apps use to reach the API (server components, server actions and the
# /api/auth proxy). May be an internal address in production. Defaults to http://localhost:4000.
API_URL=http://localhost:4000
# Cookie domain for cross-subdomain session (production: .managevent.com.au).
# Leave as localhost (or empty) in development: cookies are then host-only.
AUTH_COOKIE_DOMAIN=localhost
# Optional. Comma-separated browser origins allowed to call the API with credentials.
# When empty, the API trusts the NEXT_PUBLIC_*_URL origins above (plus localhost:3100 and
# localhost:3001 outside production).
AUTH_TRUSTED_ORIGINS=
# Shared secret between the web apps and the API, at least 32 characters. The web apps send it
# (header x-managevent-proxy-secret) with the visitor's address in x-forwarded-for; the API only
# believes a forwarded address that comes with it. Server-side only: never NEXT_PUBLIC_.
# Without it every visitor reaching the API through a web app shares that app's rate-limit bucket.
API_PROXY_SECRET=
# Name of the header the edge proxy overwrites with the real client address. Production sets it
# to x-real-ip in infra/vps/docker-compose.yml (Caddy writes that header). Leave empty when the
# API is reached directly, as in local development.
TRUSTED_CLIENT_IP_HEADER=

# ── Database (PostgreSQL, Sydney region: ap-southeast-2) ────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/managevent
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/managevent
# Field-level encryption key for health/dietary data (32 bytes, base64)
PII_ENCRYPTION_KEY=

# ── Auth (Better Auth: see ADR-0005) ────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=

# First staff account: `pnpm --filter @managevent/api staff:create` reads the password from here
# (min 12 characters). When empty, a random password is generated and printed once.
STAFF_BOOTSTRAP_PASSWORD=

# ── Guest links ─────────────────────────────────────────────────
# Platform pepper combined with per-event salt (per-event salt lives in DB).
# Required in production, at least 32 characters. Changing it invalidates every guest link and pass.
GUEST_TOKEN_PEPPER=

# ── Stripe (AUD) ────────────────────────────────────────────────
# Real keys only (sk_test_... or sk_live_...). When STRIPE_SECRET_KEY is empty the Premium upgrade
# is reported as unavailable and checkout answers 503 PAYMENTS_NOT_CONFIGURED; nothing is faked.
STRIPE_SECRET_KEY=
# Signing secret of the /v1/webhooks/stripe endpoint (whsec_...). Empty: the webhook answers 503.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PLATFORM_ACCOUNT_COUNTRY=AU

# ── Email (Resend) ──────────────────────────────────────────────
# When empty no email is sent anywhere: magic links, password reset and email invitations are
# reported as unavailable (GET /v1/me capabilities) and sending answers 503 EMAIL_NOT_CONFIGURED.
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL="Managevent <hello@managevent.com.au>"
EMAIL_FROM_INVITATIONS="Managevent Invitations <invite@invitation.managevent.com.au>"
# Planner inbox that receives new-lead notifications (worker). Empty: no notification is sent.
LEAD_NOTIFICATION_EMAIL=

# ── SMS / WhatsApp (Twilio) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_SENDER=
# Alphanumeric sender id, must be registered (see docs/compliance/MESSAGING_SPAM_ACT.md)
SMS_SENDER_ID=Managevent

# ── Storage (Cloudflare R2) ─────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC_MEDIA=managevent-public
R2_BUCKET_PRIVATE_MEDIA=managevent-private
NEXT_PUBLIC_MEDIA_CDN_URL=

# ── AI (Google Gemini via packages/ai only) ─────────────────────
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
GEMINI_MODEL_REASONING=

# ── Integrations ────────────────────────────────────────────────
ABN_LOOKUP_GUID=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Realtime (photo wall, live RSVP): see OPEN_DECISIONS D-03 ───
REALTIME_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Observability (must be AU/region-compliant: see ADR-0008) ───
SENTRY_DSN=
LOG_LEVEL=info

# ── Mobile push (Expo) ──────────────────────────────────────────
EXPO_ACCESS_TOKEN=
