# ───────────────────────────────────────────────────────────────
# Managevent: environment variables (copy to .env, never commit .env)
# Each app documents which subset it needs in its own README.
# APP_ENV: local | preview | staging | production
# ───────────────────────────────────────────────────────────────
APP_ENV=local
NODE_ENV=development

# ── Domains ─────────────────────────────────────────────────────
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_INVITATION_URL=http://localhost:3001
NEXT_PUBLIC_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_VENDORS_URL=http://localhost:3003
NEXT_PUBLIC_ADMIN_URL=http://localhost:3004
NEXT_PUBLIC_API_URL=http://localhost:4000
# Cookie domain for cross-subdomain session (production: .managevent.com.au)
AUTH_COOKIE_DOMAIN=localhost

# ── Database (PostgreSQL, Sydney region: ap-southeast-2) ────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/managevent
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/managevent
# Field-level encryption key for health/dietary data (32 bytes, base64)
PII_ENCRYPTION_KEY=

# ── Auth (Better Auth: see ADR-0005) ────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=

# ── Guest links ─────────────────────────────────────────────────
# Platform pepper combined with per-event salt (per-event salt lives in DB)
GUEST_TOKEN_PEPPER=

# ── Stripe (AUD) ────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PLATFORM_ACCOUNT_COUNTRY=AU

# ── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL="Managevent <hello@managevent.com.au>"
EMAIL_FROM_INVITATIONS="Managevent Invitations <invite@invitation.managevent.com.au>"

# ── SMS / WhatsApp (Twilio) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_SENDER=
# Alphanumeric sender id, must be registered (see docs/compliance/MESSAGING_SPAM_ACT.md)
SMS_SENDER_ID=Managevent

# ── Storage (Cloudflare R2) ─────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC_MEDIA=managevent-public
R2_BUCKET_PRIVATE_MEDIA=managevent-private
NEXT_PUBLIC_MEDIA_CDN_URL=

# ── AI (Google Gemini via packages/ai only) ─────────────────────
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
GEMINI_MODEL_REASONING=

# ── Integrations ────────────────────────────────────────────────
ABN_LOOKUP_GUID=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Realtime (photo wall, live RSVP): see OPEN_DECISIONS D-03 ───
REALTIME_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Observability (must be AU/region-compliant: see ADR-0008) ───
SENTRY_DSN=
LOG_LEVEL=info

# ── Mobile push (Expo) ──────────────────────────────────────────
EXPO_ACCESS_TOKEN=
