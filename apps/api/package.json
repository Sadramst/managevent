{
  "name": "@managevent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API: api.managevent.com.au (Hono on Node 22)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi": "./src/openapi.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"fs.rmSync('coverage', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@hono/node-server": "1.14.1",
    "@hono/zod-openapi": "0.19.10",
    "@managevent/auth": "workspace:*",
    "@managevent/config": "workspace:*",
    "@managevent/db": "workspace:*",
    "@managevent/i18n": "workspace:*",
    "@managevent/logistics": "workspace:*",
    "@managevent/payments": "workspace:*",
    "@managevent/pricing": "workspace:*",
    "@managevent/types": "workspace:*",
    "@managevent/validators": "workspace:*",
    "hono": "4.13.13",
    "pg-boss": "10.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.0.9"
  },
  "managevent": {
    "status": "scaffolded",
    "phase": "Phase 0 onward",
    "backlog": "FND-11, then every feature's API tasks",
    "spec": "ARCHITECTURE §§3, 5–12, `packages/db/DATA_MODEL.md`, ADR-0003 to 0009."
  }
}
