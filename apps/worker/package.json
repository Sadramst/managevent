{
  "name": "@managevent/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Background worker (pg-boss job registry, lead.created email job, headcount.changed logistics job)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"fs.rmSync('coverage', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@managevent/config": "workspace:*",
    "@managevent/db": "workspace:*",
    "@managevent/i18n": "workspace:*",
    "@managevent/logistics": "workspace:*",
    "@managevent/payments": "workspace:*",
    "@managevent/validators": "workspace:*",
    "pg-boss": "10.4.2",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "managevent": {
    "status": "scaffolded",
    "phase": "Phase 0 onward",
    "backlog": "FND-12, then per-feature jobs",
    "spec": "ARCHITECTURE §§6, 9–11, `packages/db/DATA_MODEL.md` retention schedule."
  }
}
