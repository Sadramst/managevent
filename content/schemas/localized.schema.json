{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "localized.schema.json",
  "title": "LocalizedText",
  "type": "object",
  "required": ["en"],
  "properties": {
    "en": { "type": "string", "minLength": 1 },
    "fa": { "type": "string" },
    "ar": { "type": "string" },
    "zh": { "type": "string" },
    "hi": { "type": "string" }
  },
  "additionalProperties": false
}
