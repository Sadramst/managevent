# Copy to `.env` next to docker-compose.yml and fill in. NEVER commit `.env`.
# Generate the three secrets with: node scripts/generate-deployment-secrets.mjs

POSTGRES_PASSWORD=

# 32-byte Base64 AES-256-GCM key for guest health & dietary data.
PII_ENCRYPTION_KEY=

# 32-byte Base64URL secret for Better Auth sessions and cookies.
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=https://api.managevent.com.au
AUTH_COOKIE_DOMAIN=managevent.com.au

# Stored, but the worker currently uses MockSafeResendAdapter (no live sends).
EMAIL_FROM_TRANSACTIONAL="Managevent <hello@managevent.com.au>"
