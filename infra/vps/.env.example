# Production environment for infra/vps/docker-compose.yml.
#
#   cp .env.example .env && chmod 600 .env        then fill it in. NEVER commit .env.
#
# Generate every secret below in one go (prints KEY=value lines, or writes a 0600 file):
#   node scripts/generate-deployment-secrets.mjs
#   node scripts/generate-deployment-secrets.mjs --out /root/managevent-secrets.env
#
# The full table (which service reads what, and what breaks without it) is infra/ENVIRONMENTS.md.
# Values are read by Docker Compose, not by a shell: write KEY=value, quote values that contain
# spaces, and do not use `export`.

# ── Required secrets ────────────────────────────────────────────────────────────────────────
# Compose refuses to start anything while one of these is empty.

# Database password. Hex only: it is embedded in a connection URL. It is applied when the
# database volume is first created; changing it later also needs ALTER ROLE (DEPLOYMENT.md).
POSTGRES_PASSWORD=

# 32 random bytes, Base64. AES-256-GCM key for guest health and dietary fields.
# LOSING IT MAKES THOSE FIELDS UNREADABLE IN EVERY BACKUP. Keep a copy off this server.
PII_ENCRYPTION_KEY=

# Signs Better Auth sessions and cookies. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# 32+ characters. Signs guest links, QR passes and unsubscribe links (api and worker).
# CHANGING IT INVALIDATES EVERY GUEST LINK AND PASS ALREADY SENT.
GUEST_TOKEN_PEPPER=

# 32+ characters. Shared by api, marketing and invitation: the web apps send it to the API so
# the API believes the visitor address they forward. Rotating it is safe (restart all three).
API_PROXY_SECRET=

# ── Required public contact details (shown on www.managevent.com.au) ────────────────────────
# These two are built into the marketing image: the public pages are prerendered at build time.
# Changing them needs a new image (bash infra/vps/deploy.sh), not only `docker compose up -d`.
# When images come from GitHub Actions, set the repository variables of the same names too.
CONTACT_EMAIL=
CONTACT_PHONE=

# ── URLs (defaults shown; change only for a different domain) ───────────────────────────────
# BETTER_AUTH_URL=https://api.managevent.com.au
# AUTH_COOKIE_DOMAIN=.managevent.com.au
# NEXT_PUBLIC_API_URL=https://api.managevent.com.au
# NEXT_PUBLIC_MARKETING_URL=https://www.managevent.com.au
# NEXT_PUBLIC_INVITATION_URL=https://invitation.managevent.com.au
# NEXT_PUBLIC_ADMIN_URL=https://www.managevent.com.au/admin
# Leave empty: the API then trusts exactly the origins of the NEXT_PUBLIC_*_URL values above.
# AUTH_TRUSTED_ORIGINS=

# ── Email (Resend). Optional ────────────────────────────────────────────────────────────────
# Empty: no email is sent anywhere. Magic links, password reset and email invitations are
# reported as unavailable, and a new enquiry is stored but nobody is notified by email.
# Set it only after the sending domain is verified in Resend (DEPLOYMENT.md, go-live checklist).
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL="Managevent <hello@managevent.com.au>"
# Empty: invitation and reminder emails are sent from EMAIL_FROM_TRANSACTIONAL. A different
# domain here must be verified in Resend as well.
EMAIL_FROM_INVITATIONS=
# Planner inbox for new-enquiry notifications. Empty: no notification is sent.
LEAD_NOTIFICATION_EMAIL=

# ── Payments (Stripe). Optional ─────────────────────────────────────────────────────────────
# Empty: the Premium upgrade is reported as unavailable and checkout answers 503. Nothing is
# faked. Use sk_live_... in production; the webhook secret is the whsec_... of the endpoint
# https://api.managevent.com.au/v1/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Images ──────────────────────────────────────────────────────────────────────────────────
# Written by infra/vps/deploy.sh on every deploy; do not edit by hand.
# IMAGE_PREFIX=managevent-
# IMAGE_TAG=local

# ── Backups (infra/vps/backup.sh). Optional but strongly recommended ────────────────────────
# BACKUP_DIR=/var/backups/managevent
# age PUBLIC key (age1...). The matching private key must NOT be stored on this server.
BACKUP_AGE_RECIPIENT=
# One off-server destination in Australia (ADR-0008). Encrypted archives only.
#   rclone:   BACKUP_RCLONE_REMOTE=vultr-syd:managevent-backups     (remote configured with `rclone config`)
#   aws cli:  BACKUP_S3_URI=s3://managevent-backups  and, for a non-AWS store, BACKUP_S3_ENDPOINT=https://...
BACKUP_RCLONE_REMOTE=
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# Optional URL fetched after each successful nightly backup (a dead-man's-switch monitor).
BACKUP_HEARTBEAT_URL=
