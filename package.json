{
  "name": "managevent",
  "private": true,
  "description": "Managevent — 0-to-100 ceremony agency, vendor marketplace and event tools. A product by Appilico.",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "node scripts/with-env.mjs turbo run build",
    "dev": "node scripts/with-env.mjs turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node scripts/with-env.mjs turbo run test",
    "test:e2e": "node scripts/with-env.mjs turbo run test:e2e",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @managevent/db db:generate",
    "db:migrate": "node scripts/with-env.mjs pnpm --filter @managevent/db db:migrate",
    "db:drift-check": "node scripts/with-env.mjs pnpm --filter @managevent/db db:drift-check",
    "db:seed": "node scripts/with-env.mjs pnpm --filter @managevent/db db:seed",
    "db:local": "node scripts/dev-db.mjs start",
    "db:local:detach": "node scripts/dev-db.mjs start --detach",
    "db:local:stop": "node scripts/dev-db.mjs stop",
    "db:local:status": "node scripts/dev-db.mjs status",
    "db:local:reset": "node scripts/dev-db.mjs reset",
    "with-env": "node scripts/with-env.mjs",
    "validate:content": "node scripts/validate-content.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "16.15.0-beta.19",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "overrides": {
      "@hono/zod-validator": "0.4.3",
      "@modelcontextprotocol/sdk": "1.11.4",
      "better-call": "1.0.8"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
