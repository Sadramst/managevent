{
  "name": "managevent",
  "private": true,
  "description": "Managevent — 0-to-100 ceremony agency, vendor marketplace and event tools. A product by Appilico.",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @managevent/db db:generate",
    "db:migrate": "pnpm --filter @managevent/db db:migrate",
    "db:drift-check": "pnpm --filter @managevent/db db:drift-check",
    "db:seed": "pnpm --filter @managevent/db db:seed",
    "validate:content": "node scripts/validate-content.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@hono/zod-validator": "0.4.3",
      "@modelcontextprotocol/sdk": "1.11.4",
      "better-call": "1.0.8"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
