{
  "name": "@managevent/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared tooling config (tsconfig, ESLint flat config, Prettier, Tailwind v4 preset, Vitest preset, log redaction)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./eslint": "./src/eslint.ts",
    "./prettier": "./src/prettier.ts",
    "./redact": "./src/redact.ts",
    "./tailwind": "./src/tailwind.ts",
    "./tailwind.css": "./tailwind.css",
    "./vitest": "./src/vitest.ts",
    "./tsconfig/*": "./tsconfig/*"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"fs.rmSync('coverage', { recursive: true, force: true })\""
  },
  "dependencies": {
    "typescript-eslint": "8.72.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.0.9",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "tailwindcss": "4.0.14",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "managevent": {
    "status": "scaffolded",
    "backlog": "FND-01"
  }
}
