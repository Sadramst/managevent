{
  "name": "@managevent/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Database schema and client (Prisma), prefixed UUIDv7 IDs, AES-256-GCM field encryption, and Perth seed",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:drift-check": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "db:seed": "tsx src/seed.ts",
    "clean": "node -e \"fs.rmSync('coverage', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@managevent/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "managevent": {
    "status": "scaffolded",
    "backlog": "FND-02"
  }
}
