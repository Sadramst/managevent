{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "APP_ENV",
    "DATABASE_URL",
    "DIRECT_URL",
    "PII_ENCRYPTION_KEY",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "AUTH_COOKIE_DOMAIN",
    "GUEST_TOKEN_PEPPER",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "RESEND_API_KEY",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "GEMINI_API_KEY",
    "GEMINI_MODEL_FAST",
    "GEMINI_MODEL_REASONING",
    "API_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_MARKETING_URL",
    "NEXT_PUBLIC_INVITATION_URL",
    "NEXT_PUBLIC_PORTAL_URL",
    "NEXT_PUBLIC_VENDORS_URL",
    "NEXT_PUBLIC_ADMIN_URL",
    "AUTH_TRUSTED_ORIGINS",
    "API_PROXY_SECRET",
    "TRUSTED_CLIENT_IP_HEADER",
    "EMAIL_FROM_TRANSACTIONAL",
    "EMAIL_FROM_INVITATIONS",
    "LEAD_NOTIFICATION_EMAIL",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["@managevent/db#db:generate", "^build", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**",
        "src-tauri/target/release/**"
      ]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["@managevent/db#db:generate", "^build"] },
    "test": { "dependsOn": ["@managevent/db#db:generate", "^build"], "outputs": ["coverage/**"] },
    "test:e2e": { "dependsOn": ["build"], "cache": false },
    "db:generate": { "cache": false },
    "db:migrate": { "cache": false },
    "clean": { "cache": false }
  }
}
